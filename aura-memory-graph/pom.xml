<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.auracyber</groupId>
		<artifactId>aura-cyber</artifactId>
		<version>0.3.1-SNAPSHOT</version>
	</parent>

	<artifactId>aura-memory-graph</artifactId>
	<packaging>jar</packaging>
	<name>AURA Memory Graph</name>
	<description>Immune Memory Graph: TTP/IoC relationship mapping via Spring Data Neo4j and behavioral embeddings via Qdrant</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-neo4j</artifactId>
		</dependency>
		<dependency>
			<groupId>io.qdrant</groupId>
			<artifactId>client</artifactId>
			<version>${qdrant.version}</version>
		</dependency>
		<!-- io.qdrant:client publishes its gRPC/protobuf/Guava API types as runtime-scoped,
		     yet exposes them in its public signatures (ListenableFuture, generated messages). -->
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>${guava.version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.protobuf</groupId>
			<artifactId>protobuf-java</artifactId>
		</dependency>
		<dependency>
			<groupId>io.grpc</groupId>
			<artifactId>grpc-inprocess</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-neo4j</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
