<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.auracyber</groupId>
		<artifactId>aura-cyber</artifactId>
		<version>0.1.1-SNAPSHOT</version>
	</parent>

	<artifactId>aura-orchestrator</artifactId>
	<packaging>jar</packaging>
	<name>AURA Orchestrator</name>
	<description>Threat intelligence bus: Spring Boot entrypoint routing events between Sentinel, Synthesizer, Immunizer and Red Team agents</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>
		<dependency>
			<groupId>com.auracyber</groupId>
			<artifactId>aura-telemetry</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.auracyber</groupId>
			<artifactId>aura-memory-graph</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.auracyber</groupId>
			<artifactId>aura-agent-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.auracyber</groupId>
			<artifactId>aura-cce-engine</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.auracyber</groupId>
			<artifactId>aura-sandbox-executor</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
